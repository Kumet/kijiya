# Anthropic APIキー (必須)
ANTHROPIC_API_KEY=

# 生成に使うモデル
MODEL=claude-sonnet-5

# LLM出力トークン上限
MAX_TOKENS=8000

# URL取得タイムアウト(秒)
FETCH_TIMEOUT=15.0

# 取得HTMLの上限サイズ(バイト)
MAX_DOWNLOAD_BYTES=3000000

# LLMへ渡す本文の最大文字数
MAX_SOURCE_CHARS=24000

# 生成物の保持時間(秒)
DOC_TTL_SECONDS=1800

# ストアの最大件数
MAX_DOCS=200

# Trueでプライベートアドレスを許可 (ローカル検証用)
ALLOW_PRIVATE_HOSTS=False

# 同一IPからの生成回数上限 (1時間あたり)
RATE_LIMIT_PER_HOUR=30
